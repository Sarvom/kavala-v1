# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (Phase 2). Leave blank to run without a database: the beacon API
# then validates requests but reports that nothing was stored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign in-person handshake codes. Use a random string of at
# least 32 characters, for example from: openssl rand -hex 32
HANDSHAKE_SECRET=

# true shortens demo wait times. Set to false in production.
DEMO_MODE=true
